# Exact frontend origin(s) allowed by the backend. Separate multiple origins with commas.
FRONTEND_ORIGIN=http://localhost:5173

# These are optional; relative paths resolve from the repository root.
MODEL_PATH=Models/forestdr_pipe.joblib
DRIFT_REFERENCE_PATH=Models/drift_reference.json
EVALUATION_DATA_PATH=Data/Processed/test.csv

# Vite reads this in dashboard/.env.local, not from the repository-root .env.
VITE_API_BASE_URL=http://localhost:8000
